NODE_ENV=development
PORT=4000
# Frontend dev server port
WEB_PORT=5173
# Public API base URL used by the dummy frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000

MONGODB_URI=
MONGODB_DB_NAME=dungeonsdaily

# Gemma — open-weight AI core (Dungeon Master), via Vercel AI SDK.
# Preferred: OpenRouter gateway (free Gemma 3 models). Get a key at https://openrouter.ai.
# Fallback: Google provider directly (key at https://aistudio.google.com).
# Server-side only — never expose to the frontend.
# Match GEMMA_MODEL to the path whose key is set (openrouter id vs google id).
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# Server TTS is disabled — the browser speaks via speechSynthesis.
# These are unused (kept only so old setups don't break):
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Browser error reports (public by design; traces/replay stay off).
VITE_SENTRY_DSN=
